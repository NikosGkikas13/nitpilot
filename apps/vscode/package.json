{
  "name": "nitpilot-vscode",
  "private": true,
  "version": "0.1.0",
  "displayName": "Nitpilot",
  "description": "See your Nitpilot PRs and what they need from you, without leaving VS Code.",
  "publisher": "nitpilot",
  "license": "MIT",
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikosGkikas13/nitpilot.git",
    "directory": "apps/vscode"
  },
  "homepage": "https://nitpilot.dev/docs/vscode",
  "bugs": {
    "url": "https://github.com/NikosGkikas13/nitpilot/issues"
  },
  "contributes": {},
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies -o dist/nitpilot.vsix"
  },
  "devDependencies": {
    "@nitpilot/protocol": "*",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.0",
    "nitpilot": "*",
    "ovsx": "^1.3.0",
    "tsup": "^8.5.1",
    "zod": "^4.6.5"
  }
}
