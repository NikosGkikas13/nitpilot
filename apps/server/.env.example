# Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgresql://nitpilot:nitpilot@localhost:5433/nitpilot
PORT=8787
# Where people reach Nitpilot. In development that's Vite (npm run dev -w apps/web), which passes the
# server's paths on to port 8787 (docs/why/serving-a-spa.md); with the dev tunnel it's the tunnel URL.
PUBLIC_URL=http://localhost:5173
# openssl rand -base64 32
ENCRYPTION_KEY=

# From your dev GitHub App "nitpilot-dev" (Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=nitpilot-dev
# The app's private key; paste it on one line with \n for the line breaks
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Web Push (optional; all three or none). Without them push is off and the CLI shows every notification.
# `npm run vapid:keys -w apps/server` prints a fresh pair to paste here; VAPID_SUBJECT is a mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# The built web app; leave unset to use apps/web/dist
# WEB_DIST_DIR=

# Hosted instance only
PUBLIC_REPOS_ONLY=false
ALLOWED_LOGINS=
# Behind our reverse proxy (Caddy): read the client's address from X-Forwarded-For. Leave false anywhere else.
TRUST_PROXY=false
# Delete chats this many days after they closed. Empty keeps them forever.
CLOSED_CHAT_RETENTION_DAYS=
