{
  "name": "nitpilot",
  "version": "0.3.1",
  "description": "Your own AI agent reviews your teammates' pull requests, and theirs reviews yours.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikosGkikas13/nitpilot.git",
    "directory": "apps/cli"
  },
  "homepage": "https://nitpilot.dev",
  "bugs": {
    "url": "https://github.com/NikosGkikas13/nitpilot/issues"
  },
  "keywords": [
    "code-review",
    "pull-request",
    "github",
    "ai",
    "claude-code",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "nitpilot": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:live": "NITPILOT_LIVE=1 vitest run --reporter=verbose src/agents/conformance/live.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@nitpilot/protocol": "*",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.18.2",
    "picomatch": "^4.0.7",
    "tsup": "^8.5.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
