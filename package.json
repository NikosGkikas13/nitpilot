{
  "name": "nitpilot-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w apps/web",
    "test": "npm run test --workspaces --if-present && node --test 'scripts/*.test.mjs'",
    "test:e2e": "npm run test:e2e -w apps/server",
    "test:web-e2e": "npm run build && npm run test:e2e -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "dev:tunnel": "npm run dev:tunnel -w apps/server",
    "image:smoke": "bash scripts/image-smoke.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
